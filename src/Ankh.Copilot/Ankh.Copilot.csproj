<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Ankh.Copilot</AssemblyName>
    <RootNamespace>Ankh.Copilot</RootNamespace>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the VS Copilot contract, but never ship Microsoft's
         implementation in the VSIX. The installed Visual Studio supplies it. -->
    <PackageReference Include="Microsoft.VisualStudio.Copilot">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
  </ItemGroup>
</Project>
